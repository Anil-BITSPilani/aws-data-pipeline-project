{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3BucketIngestionReadAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::YOUR_S3_BUCKET_NAME/*"
        },
        {
            "Sid": "DynamoDBMetadataWriteAccess",
            "Effect": "Allow",
            "Action": [
                "dynamodb:PutItem"
            ],
            "Resource": "arn:aws:dynamodb:*:YOUR_ACCOUNT_ID:table/FileProcessingMetadata"
        },
        {
            "Sid": "CloudWatchLogStreamsAccess",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:*:YOUR_ACCOUNT_ID:log-group:/aws/lambda/*"
        }
    ]
}
